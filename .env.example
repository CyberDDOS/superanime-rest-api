# Supabase credentials (wajib untuk sync database)
SUPABASE_URL=https://your-project.supabase.co
# Service role key: dipakai backend untuk menulis ke tabel konten (melewati RLS).
# Rahasia — jangan pernah dipakai atau di-commit di frontend.
# API KEY Supabase service role bisa dibuat di Project Settings → API Keys → Secret keys
# di halaman Project Settings → API Keys.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Anon key (opsional): cadangan hanya-baca bila service role key kosong.
SUPABASE_ANON_KEY=

# Secret untuk POST /sync/:source/:type, dikirim sebagai
# "Authorization: Bearer <secret>". Tanpa ini /sync ditutup.
# (CRON_SECRET dari Vercel Cron juga diterima.)
SYNC_SECRET=

# Port (opsional, default 3001)
PORT=3001

# Kuramanime: override field `authorization` halaman stream (opsional).
# Normalnya diekstrak otomatis dari leviathan.js; isi hanya bila ekstraksi gagal.
# KURAMANIME_AUTHORIZATION=
